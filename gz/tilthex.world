<?xml version="1.0"?>
<sdf version="1.5">
<world name="mrsim">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"> </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"> </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libgz-sim-imu-system" name="gz::sim::systems::Imu" />

    <physics type='ode'>
        <max_step_size>0.002000</max_step_size>
        <real_time_factor>1.000000</real_time_factor>
        <real_time_update_rate>500.000000</real_time_update_rate>
        <gravity>0 0 -9.81</gravity>
        <magnetic_field>23.816e-6 -0.41e-6 -39.829e-6</magnetic_field>
    </physics>

    <light type="directional" name="sun">
        <cast_shadows>false</cast_shadows>
        <pose>0 0 9.5 0 0 0</pose>
        <diffuse>0.8 0.8 0.8 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
        <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
        </attenuation>
        <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
        <static>true</static>
        <link name="link">
            <pose>0 0 -0.05 0 0 0</pose>
            <collision name="collision">
                <geometry>
                    <box>
                        <size>20 20 0.1</size>
                    </box>
                </geometry>
            </collision>
            <visual name="visual">
                <geometry>
                    <box>
                        <size>20 20 0.1</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.8 0.8 0.8 1</ambient>
                    <diffuse>0.8 0.8 0.8 1</diffuse>
                    <specular>0.8 0.8 0.8 1</specular>
                </material>
            </visual>
        </link>
    </model>

    <model name="textures">
        <static>true</static>
        <link name="wall_x">
            <pose>10 0 5 0 0 1.57</pose>
            <collision name="collision">
                <geometry>
                <box>
                    <size>20 0.1 10.0</size>
                </box>
                </geometry>
            </collision>
            <visual name="visual">
                <geometry>
                    <box>
                        <size>20 0.1 10.0</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.8 0.8 0.8 1</ambient>
                    <diffuse>0.8 0.8 0.8 1</diffuse>
                    <specular>0.8 0.8 0.8 1</specular>
                </material>
            </visual>
        </link>
        <link name="wall_y">
           <pose>0 10 5 0 0 0</pose>
            <collision name="collision">
                <geometry>
                <box>
                    <size>20 0.1 10.0</size>
                </box>
                </geometry>
            </collision>
            <visual name="visual">
                <geometry>
                    <box>
                        <size>20 0.1 10.0</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.8 0.8 0.8 1</ambient>
                    <diffuse>0.8 0.8 0.8 1</diffuse>
                    <specular>0.8 0.8 0.8 1</specular>
                </material>
            </visual>
        </link>
        <link name="roof">
            <pose>0 0 8 0 0 0</pose>
            <collision name="collision">
                <geometry>
                <box>
                    <size>20 20 0.1</size>
                </box>
                </geometry>
            </collision>
            <visual name="visual">
                <geometry>
                    <box>
                        <size>20 20 0.1</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.8 0.8 0.8 1</ambient>
                    <diffuse>0.8 0.8 0.8 1</diffuse>
                    <specular>0.8 0.8 0.8 1</specular>
                </material>
            </visual>
        </link>
        <link name="tpillar0">
            <pose>0 5 2 0 0.79 0</pose>
            <collision name="collision">
                <geometry>
                    <cylinder><radius>0.5</radius><length>10</length></cylinder>
                </geometry>
            </collision>
            <visual name="visual">
                <geometry>
                    <cylinder><radius>0.5</radius><length>10</length></cylinder>
                </geometry>
                <material>
                    <ambient>0.8 0.8 0.8 1</ambient>
                    <diffuse>0.8 0.8 0.8 1</diffuse>
                    <specular>0.8 0.8 0.8 1</specular>
                </material>
            </visual>
        </link>
        <link name="hpillar1">
            <pose>0 5 1 0 1.57 0</pose>
            <collision name="collision">
                <geometry>
                    <cylinder><radius>0.5</radius><length>10</length></cylinder>
                </geometry>
            </collision>
            <visual name="visual">
                <geometry>
                    <cylinder><radius>0.5</radius><length>10</length></cylinder>
                </geometry>
                <material>
                    <ambient>0.8 0.8 0.8 1</ambient>
                    <diffuse>0.8 0.8 0.8 1</diffuse>
                    <specular>0.8 0.8 0.8 1</specular>
                </material>
            </visual>
        </link>
        <link name="hpillar2">
            <pose>5 0 1 1.57 0 0</pose>
            <collision name="collision">
                <geometry>
                    <cylinder><radius>0.5</radius><length>10</length></cylinder>
                </geometry>
            </collision>
            <visual name="visual">
                <geometry>
                    <cylinder><radius>0.5</radius><length>10</length></cylinder>
                </geometry>
                <material>
                    <ambient>0.8 0.8 0.8 1</ambient>
                    <diffuse>0.8 0.8 0.8 1</diffuse>
                    <specular>0.8 0.8 0.8 1</specular>
                </material>
            </visual>
        </link>
        <link name="hpillar3">
            <pose>5 0 4 1.57 0 0</pose>
            <collision name="collision">
                <geometry>
                    <cylinder><radius>0.5</radius><length>10</length></cylinder>
                </geometry>
            </collision>
            <visual name="visual">
                <geometry>
                    <cylinder><radius>0.5</radius><length>10</length></cylinder>
                </geometry>
                <material>
                    <ambient>0.8 0.8 0.8 1</ambient>
                    <diffuse>0.8 0.8 0.8 1</diffuse>
                    <specular>0.8 0.8 0.8 1</specular>
                </material>
            </visual>
        </link>
        <link name="pillar1">
            <pose>5 5 2 0 0 0</pose>
            <collision name="collision">
                <geometry>
                    <cylinder><radius>0.5</radius><length>4</length></cylinder>
                </geometry>
            </collision>
            <visual name="visual">
                <geometry>
                    <cylinder><radius>0.5</radius><length>4</length></cylinder>
                </geometry>
                <material>
                    <ambient>0.8 0.8 0.8 1</ambient>
                    <diffuse>0.8 0.8 0.8 1</diffuse>
                    <specular>0.8 0.8 0.8 1</specular>
                </material>
            </visual>
        </link>
        <link name="pillar2">
            <pose>-5 5 3 0 0 0</pose>
            <collision name="collision">
                <geometry>
                    <cylinder><radius>0.5</radius><length>6</length></cylinder>
                </geometry>
            </collision>
            <visual name="visual">
                <geometry>
                    <cylinder><radius>0.5</radius><length>6</length></cylinder>
                </geometry>
                <material>
                    <ambient>0.8 0.8 0.8 1</ambient>
                    <diffuse>0.8 0.8 0.8 1</diffuse>
                    <specular>0.8 0.8 0.8 1</specular>
                </material>
            </visual>
        </link>
        <link name="pillar3">
            <pose>5 -5 2 0 0 0</pose>
            <collision name="collision">
                <geometry>
                    <cylinder><radius>0.5</radius><length>4</length></cylinder>
                </geometry>
            </collision>
            <visual name="visual">
                <geometry>
                    <cylinder><radius>0.5</radius><length>4</length></cylinder>
                </geometry>
                <material>
                    <ambient>0.8 0.8 0.8 1</ambient>
                    <diffuse>0.8 0.8 0.8 1</diffuse>
                    <specular>0.8 0.8 0.8 1</specular>
                </material>
            </visual>
        </link>
    </model>

    <model name="TX">
        <pose>0 0 0.2 0 0 0</pose>
        <include>
            <uri>model://mrsim-tilthex</uri>
            <name>tx</name>
        </include>
        <include>
            <pose>0 0 0.05 0 0 0</pose>
            <uri>model://livox-mid360</uri>
            <name>livox</name>
        </include>
        <joint name="lidar_joint" type="fixed">
            <parent>tx::base</parent>
            <child>livox::base</child>
        </joint>
        <include>
            <pose>0 0 0 0 0 0.5236</pose>
            <uri>model://tilthex-ee</uri>
            <name>ee</name>
        </include>
        <joint name="ee_joint" type="fixed">
            <parent>tx::base</parent>
            <child>ee::base</child>
        </joint>
    </model>

    <plugin name="optitrack" filename="optitrack-gazebo-2.0.so">
        <hz>1000</hz>
        <port>1509</port>
        <publish>
            <link>TX::tx::base</link>
            <name>TX</name>
        </publish>
    </plugin>
</world>
</sdf>
